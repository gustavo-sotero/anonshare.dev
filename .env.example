# anonshare unified environment variables
# Copy this file to .env at the repository root and configure all values here.

# Runtime
NODE_ENV=development

# Application URLs
APP_BASE_URL=http://localhost:3000
APP_API_URL=http://localhost:3001

# API and worker ports
PORT=3001
WORKER_HEALTH_PORT=3002

# PostgreSQL (used by API/worker and Docker Compose)
POSTGRES_USER=anonshare
POSTGRES_PASSWORD=anonshare
POSTGRES_DB=anonshare
POSTGRES_PORT=5432
DATABASE_URL=postgresql://anonshare:anonshare@localhost:5432/anonshare

# Redis (used by API/worker and Docker Compose)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# S3-compatible storage (used by API/worker and Docker Compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=anonshare
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=anonshare
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_BASE_URL=

# Admin GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_USER_ID=

# Admin session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=