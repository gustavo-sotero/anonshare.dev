{
  "name": "@anonshare/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd ../.. && bun --env-file=.env --watch apps/worker/src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun --env-file=../../.env run dist/index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anonshare/contracts": "workspace:*",
    "@anonshare/domain": "workspace:*",
    "@anonshare/infrastructure": "workspace:*",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1"
  }
}
