# anonshare API environment variables
# Copy to .env and fill in values. Never commit .env to source control.

PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgresql://anonshare:anonshare@localhost:5432/anonshare

# Redis connection string
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO for local development)
# These credentials match the local Docker Compose defaults and should be rotated outside local development.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=anonshare
STORAGE_REGION=us-east-1
# Optional: public base URL for storage links (leave empty to generate signed URLs)
STORAGE_PUBLIC_BASE_URL=

# GitHub OAuth (registered at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Stable numeric GitHub user ID of the sole administrator
GITHUB_ALLOWED_USER_ID=

# Session signing secret (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Public base URL of the web application (for constructing share links)
APP_BASE_URL=http://localhost:3000
